<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Merchant Dashboard - Foodo</title>

    .dashboard-container {
    display: flex;
    min-height: calc(100vh - 80px);
    /* Adjust based on header height */
    }

    .sidebar {
    width: 250px;
    background: #fff;
    border-right: 1px solid #eee;
    padding: 20px 0;
    flex-shrink: 0;
    }

    .sidebar .nav-link {
    color: #333;
    padding: 15px 25px;
    font-weight: 500;
    border-radius: 0;
    transition: all 0.3s;
    }

    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
    background: #f8f9fa;
    color: #ffc107;
    border-right: 3px solid #ffc107;
    }

    .sidebar .nav-link i {
    margin-right: 10px;
    width: 20px;
    text-align: center;
    }

    .content-area {
    flex-grow: 1;
    padding: 30px;
    background: #fcfcfc;
    }

    .tab-pane {
    display: none;
    animation: fadeIn 0.3s;
    }

    .tab-pane.active {
    display: block;
    }

    @keyframes fadeIn {
    from {
    opacity: 0;
    transform: translateY(10px);
    }

    to {
    opacity: 1;
    transform: translateY(0);
    }
    }

    .section-header {
    margin-bottom: 30px;
    padding-bottom: 15px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .badge-attribute {
    font-size: 0.8rem;
    margin-right: 5px;
    margin-bottom: 5px;
    display: inline-block;
    }
    </style>
</head>

<body>

    <header class="header">
        <div class="container-fluid d-flex justify-content-between align-items-center m-0">

            <a href="#" class="d-flex align-items-center text-decoration-none p-1">
                <img src="icons/Logo.png" alt="Logo" height="60">
            </a>

            <div class="d-flex align-items-center gap-2">

                <a href="Login.html" class="btn btn-primary">Login</a>
                <a href="Register.html" class="btn btn-primary">Register</a>

                <!-- Dropdown -->
                <div class="btn-group d-none" id="drop">
                    <a href="#" class="btn-img img dropdown-toggle rounded-circle" data-bs-toggle="dropdown"
                        aria-expanded="false"
                        style="background-image: url('images/user.png'); width:50px; height:50px;">
                    </a>

                    <div class="dropdown-menu dropdown-menu-end mt-2">
                        <a class="dropdown-item d-flex align-items-center" href="#">
                            <div class="icon d-flex align-items-center justify-content-center me-3">
                                <span class="ion-ios-settings"></span>
                            </div>
                            Settings
                        </a>

                        <a class="dropdown-item d-flex align-items-center" id="logout" href="#">
                            <div class="icon d-flex align-items-center justify-content-center me-3">
                                <span class="ion-ios-power"></span>
                            </div>
                            Log Out
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <nav class="nav flex-column">
                <a class="nav-link active" href="#" onclick="showTab('products', this)">
                    <i class="ion-ios-list"></i> Products
                </a>
                <a class="nav-link" href="#" onclick="showTab('orders', this); loadOrders()">
                    <i class="ion-ios-cart"></i> Orders
                </a>
                <a class="nav-link" href="#" onclick="showTab('customers', this); loadCustomers()">
                    <i class="ion-ios-people"></i> Customers
                </a>
            </nav>
        </div>

        <!-- Content Area -->
        <div class="content-area">

            <!-- Products Management -->
            <div id="products" class="tab-pane active">
                <div class="section-header">
                    <h3>Product Management</h3>
                    <button class="btn btn-primary" onclick="openProductModal()">
                        <i class="ion-ios-add-circle"></i> Add New Product
                    </button>
                </div>

                <div class="card p-4">
                    <div class="mb-3">
                        <input type="text" id="productSearch" class="form-control" placeholder="Search products..."
                            onkeyup="filterProducts()">
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Price</th>
                                    <th>Description</th>
                                    <th>Attributes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productsTableBody">
                                <!-- Products will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span id="productsPageInfo">Page 1</span>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary"
                            onclick="changePage('products', -1)">Previous</button>
                        <button class="btn btn-sm btn-outline-secondary"
                            onclick="changePage('products', 1)">Next</button>
                    </div>
                </div>
            </div>

            <!-- Orders Management -->
            <div id="orders" class="tab-pane">
                <div class="section-header">
                    <h3>Order Management</h3>
                    <button class="btn btn-outline-secondary" onclick="loadOrders()">
                        <i class="ion-ios-refresh"></i> Refresh
                    </button>
                </div>
                <div class="card p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ordersTableBody">
                                <!-- Orders will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span id="ordersPageInfo">Page 1</span>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary"
                            onclick="changePage('orders', -1)">Previous</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="changePage('orders', 1)">Next</button>
                    </div>
                </div>
            </div>

            <!-- Customers -->
            <div id="customers" class="tab-pane">
                <div class="section-header">
                    <h3>Customers</h3>
                    <button class="btn btn-outline-secondary" onclick="loadCustomers()">
                        <i class="ion-ios-refresh"></i> Refresh
                    </button>
                </div>
                <div class="card p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Last Purchased</th>
                                    <th>Total Orders</th>
                                    <th>Total Spent</th>
                                </tr>
                            </thead>
                            <tbody id="customersTableBody">
                                <!-- Customers will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span id="customersPageInfo">Page 1</span>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary"
                            onclick="changePage('customers', -1)">Previous</button>
                        <button class="btn btn-sm btn-outline-secondary"
                            onclick="changePage('customers', 1)">Next</button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Product Modal (Create/Edit) -->
    <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productModalLabel">Add Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Product</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Details Modal -->
    <div class="modal fade" id="orderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Order Details #<span id="orderModalId"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6>Customer Info</h6>
                            <p class="mb-1" id="orderCustomerName"></p>
                        </div>
                        <div class="col-md-6 text-end">
                            <h6>Order Info</h6>
                            <p class="mb-1" id="orderDate"></p>
                            <p class="mb-1 fw-bold" id="orderStatusDisplay"></p>
                        </div>
                    </div>

                    <h6>Items</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Price</th>
                                    <th>Qty</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody id="orderItemsTableBody"></tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Total Amount:</td>
                                    <td class="fw-bold" id="orderTotalAmount"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="border-top pt-3">
                        <label for="orderStatusSelect" class="form-label">Update Status</label>
                        <div class="d-flex gap-2">
                            <select class="form-select" id="orderStatusSelect">
                                <option value="Pending">Pending</option>
                                <option value="InProgress">In Progress</option>
                                <option value="OutForDelivery">Out For Delivery</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <button class="btn btn-primary" onclick="updateOrderStatus()">Update</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this product? This action cannot be undone.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- Tab Logic ---
        function showTab(tabId, linkElement) {
            document.querySelectorAll('.tab-pane').forEach(tab => tab.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            document.querySelectorAll('.sidebar .nav-link').forEach(link => link.classList.remove('active'));
            linkElement.classList.add('active');
        }

        // --- Product Management Logic ---
        let currentProducts = [];
        let productModal;
        let deleteModal;
        let productToDeleteId = null;

        // --- Order Management Logic ---
        let currentOrders = [];
        let orderModalInstance;

        document.addEventListener('DOMContentLoaded', () => {
            Authentication.requireRole('Merchant');

            // Initialize Bootstrap modals
            productModal = new bootstrap.Modal(document.getElementById('productModal'));
            deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            if (!customers || customers.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center">No customers found.</td></tr>';
                return;
            }

            customers.forEach(c => {
                const row = document.createElement('tr');
                const lastPurchased = new Date(c.lastPurchased).toLocaleDateString();

                row.innerHTML = `
                    <td>${c.fullName}</td>
                    <td>${c.email}</td>
                    <td>${c.phoneNumber}</td>
                    <td>${lastPurchased}</td>
                    <td>${c.totalOrders}</td>
                    <td>$${c.totalSpent.toFixed(2)}</td>
                `;
                tbody.appendChild(row);
            });
        }
    </script>

</body>

</html>